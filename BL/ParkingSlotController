package bl;

import db.BookingDAO;
import db.ParkingSlotDAO;
import java.util.List;

public class ParkingSlotController {

    private final ParkingSlotDAO slotDAO;
    private final BookingDAO     bookingDAO;

    public ParkingSlotController() {
        this.slotDAO    = new ParkingSlotDAO();
        this.bookingDAO = new BookingDAO();
    }

    public List<ParkingSlot> viewAvailableSlots() {
        List<ParkingSlot> slots = slotDAO.getAvailableSlots();
        System.out.println("Available slots retrieved: " + slots.size());
        return slots;
    }

    public List<ParkingSlot> getAllSlots() {
        return slotDAO.getAllSlots();
    }

    public int countAvailableSlots() {
        return slotDAO.getAvailableSlots().size();
    }

    public int countReservedSlots() {
        List<ParkingSlot> all = slotDAO.getAllSlots();
        int count = 0;
        for (ParkingSlot slot : all) {
            if (slot.getStatus().equals("reserved")) count++;
        }
        return count;
    }

    public int countTotalSlots() {
        return slotDAO.getAllSlots().size();
    }

    public boolean reserveSlot(int slotId) {
        return slotDAO.updateSlotStatus(slotId, "reserved");
    }

    public boolean releaseSlot(int slotId) {
        return slotDAO.updateSlotStatus(slotId, "available");
    }

    public ParkingSlot getSlotById(int slotId) {
        return slotDAO.getSlotById(slotId);
    }

    // ── Auto-release slots whose booking time has expired ────────────────────
    public void refreshSlotStatuses() {
        List<ParkingSlot> all = slotDAO.getAllSlots();
        for (ParkingSlot slot : all) {
            if (slot.getStatus().equals("reserved")) {
                boolean stillActive =
                        bookingDAO.hasActiveBookingForSlot(slot.getSlotId());
                if (!stillActive) {
                    slotDAO.updateSlotStatus(slot.getSlotId(), "available");
                }
            }
        }
    }
}
