package ui;

import db.DBConnection;
import javafx.application.Application;
import javafx.geometry.Insets;
import javafx.geometry.Pos;
import javafx.scene.Scene;
import javafx.scene.control.*;
import javafx.scene.layout.*;
import javafx.scene.paint.Color;
import javafx.scene.text.Font;
import javafx.scene.text.FontWeight;
import javafx.stage.Stage;

import java.sql.Connection;
import java.sql.PreparedStatement;
import java.sql.ResultSet;

public class LoginUI extends Application {

    @Override
    public void start(Stage stage) {
        stage.setTitle("Smart Parking System - Login");

        // ── MAIN LAYOUT ──
        VBox mainLayout = new VBox();
        mainLayout.setStyle("-fx-background-color: #1a1a2e;");
        mainLayout.setAlignment(Pos.CENTER);

        // ── LEFT PANEL (branding) ──
        VBox leftPanel = new VBox(15);
        leftPanel.setPadding(new Insets(50));
        leftPanel.setAlignment(Pos.CENTER);
        leftPanel.setStyle("-fx-background-color: #16213e;");
        leftPanel.setPrefWidth(400);

        Label bigIcon = new Label("🅿");
        bigIcon.setFont(Font.font(80));

        Label brandName = new Label("Smart Parking");
        brandName.setFont(Font.font("Arial", FontWeight.BOLD, 28));
        brandName.setTextFill(Color.WHITE);

        Label brandSub = new Label("Allocation & Violation\nEnforcement System");
        brandSub.setFont(Font.font("Arial", 14));
        brandSub.setTextFill(Color.web("#8888aa"));
        brandSub.setAlignment(Pos.CENTER);

        // Feature bullets
        VBox features = new VBox(10);
        features.setPadding(new Insets(20, 0, 0, 0));
        features.getChildren().addAll(
                featureItem("📋", "View Booking History"),
                featureItem("🔔", "Violation Notifications"),
                featureItem("🔍", "Scan License Plates")
        );

        leftPanel.getChildren().addAll(bigIcon, brandName, brandSub, features);

        // ── RIGHT PANEL (login form) ──
        VBox rightPanel = new VBox(20);
        rightPanel.setPadding(new Insets(50, 40, 50, 40));
        rightPanel.setAlignment(Pos.CENTER);
        rightPanel.setStyle("-fx-background-color: #1a1a2e;");
        rightPanel.setPrefWidth(400);

        Label loginTitle = new Label("Welcome ");
        loginTitle.setFont(Font.font("Arial", FontWeight.BOLD, 26));
        loginTitle.setTextFill(Color.WHITE);

        Label loginSub = new Label("Sign in to continue");
        loginSub.setFont(Font.font("Arial", 13));
        loginSub.setTextFill(Color.web("#8888aa"));

        // Role selector
        Label roleLabel = new Label("Login as:");
        roleLabel.setFont(Font.font("Arial", FontWeight.BOLD, 13));
        roleLabel.setTextFill(Color.web("#a0a0c0"));

        HBox roleBox = new HBox(10);
        roleBox.setAlignment(Pos.CENTER_LEFT);

        ToggleGroup roleGroup = new ToggleGroup();

        RadioButton ownerBtn = new RadioButton("Vehicle Owner");
        ownerBtn.setToggleGroup(roleGroup);
        ownerBtn.setSelected(true);
        ownerBtn.setStyle("-fx-text-fill: white; -fx-font-size: 13px;");

        RadioButton officerBtn = new RadioButton("Parking Officer");
        officerBtn.setToggleGroup(roleGroup);
        officerBtn.setStyle("-fx-text-fill: white; -fx-font-size: 13px;");

        roleBox.getChildren().addAll(ownerBtn, officerBtn);

        // Email field
        Label emailLabel = new Label("Email");
        emailLabel.setFont(Font.font("Arial", FontWeight.BOLD, 13));
        emailLabel.setTextFill(Color.web("#a0a0c0"));

        TextField emailField = new TextField();
        emailField.setPromptText("Enter your email");
        emailField.setStyle(
                "-fx-background-color: #16213e; -fx-text-fill: white; " +
                        "-fx-prompt-text-fill: #555577; -fx-font-size: 14px; " +
                        "-fx-padding: 12 16; -fx-background-radius: 8; " +
                        "-fx-border-color: #2a2a4e; -fx-border-radius: 8;"
        );

        // Password field
        Label passLabel = new Label("Password");
        passLabel.setFont(Font.font("Arial", FontWeight.BOLD, 13));
        passLabel.setTextFill(Color.web("#a0a0c0"));

        PasswordField passField = new PasswordField();
        passField.setPromptText("Enter your password");
        passField.setStyle(
                "-fx-background-color: #16213e; -fx-text-fill: white; " +
                        "-fx-prompt-text-fill: #555577; -fx-font-size: 14px; " +
                        "-fx-padding: 12 16; -fx-background-radius: 8; " +
                        "-fx-border-color: #2a2a4e; -fx-border-radius: 8;"
        );

        // Error label
        Label errorLabel = new Label("");
        errorLabel.setFont(Font.font("Arial", 12));
        errorLabel.setTextFill(Color.web("#ff6b6b"));

        // Login button
        Button loginBtn = new Button("Sign In →");
        loginBtn.setMaxWidth(Double.MAX_VALUE);
        loginBtn.setStyle(
                "-fx-background-color: #0f3460; -fx-text-fill: white; " +
                        "-fx-font-size: 15px; -fx-font-weight: bold; " +
                        "-fx-padding: 13 0; -fx-background-radius: 8; -fx-cursor: hand;"
        );

        // Hint label
        Label hintLabel = new Label("Owner: test@test.com / owner123\nOfficer: officer@parking.com / officer123");
        hintLabel.setFont(Font.font("Arial", 11));
        hintLabel.setTextFill(Color.web("#555577"));
        hintLabel.setAlignment(Pos.CENTER);

        // Login action
        loginBtn.setOnAction(e -> {
            String email = emailField.getText().trim();
            String password = passField.getText().trim();
            boolean isOwner = ownerBtn.isSelected();

            if (email.isEmpty() || password.isEmpty()) {
                errorLabel.setText("Please enter email and password!");
                return;
            }

            if (isOwner) {
                int ownerId = validateOwner(email, password);
                if (ownerId != -1) {
                    openOwnerDashboard(stage, ownerId);
                } else {
                    errorLabel.setText("Invalid email or password!");
                }
            } else {
                int officerId = validateOfficer(email, password);
                if (officerId != -1) {
                    openOfficerDashboard(stage);
                } else {
                    errorLabel.setText("Invalid email or password!");
                }
            }
        });

        rightPanel.getChildren().addAll(
                loginTitle, loginSub,
                roleLabel, roleBox,
                emailLabel, emailField,
                passLabel, passField,
                errorLabel, loginBtn,
                hintLabel
        );

        // ── COMBINE PANELS ──
        HBox content = new HBox();
        content.getChildren().addAll(leftPanel, rightPanel);
        content.setMaxWidth(800);
        content.setStyle("-fx-background-radius: 12;");

        mainLayout.getChildren().add(content);

        Scene scene = new Scene(mainLayout, 900, 600);
        stage.setScene(scene);
        stage.setMinWidth(800);
        stage.setMinHeight(500);
        stage.show();
    }

    private int validateOwner(String email, String password) {
        try {
            Connection conn = DBConnection.getInstance().getConnection();
            String query = "SELECT owner_id FROM vehicle_owners " +
                    "WHERE email = ? AND password = ?";
            PreparedStatement stmt = conn.prepareStatement(query);
            stmt.setString(1, email);
            stmt.setString(2, password);
            ResultSet rs = stmt.executeQuery();
            if (rs.next()) return rs.getInt("owner_id");
        } catch (Exception e) {
            System.out.println("Login error: " + e.getMessage());
        }
        return -1;
    }

    private int validateOfficer(String email, String password) {
        try {
            Connection conn = DBConnection.getInstance().getConnection();
            String query = "SELECT officer_id FROM parking_officers " +
                    "WHERE email = ? AND password = ?";
            PreparedStatement stmt = conn.prepareStatement(query);
            stmt.setString(1, email);
            stmt.setString(2, password);
            ResultSet rs = stmt.executeQuery();
            if (rs.next()) return rs.getInt("officer_id");
        } catch (Exception e) {
            System.out.println("Login error: " + e.getMessage());
        }
        return -1;
    }

    private void openOwnerDashboard(Stage stage, int ownerId) {
        try {
            DashboardUI dashboard = new DashboardUI();
            dashboard.start(stage);
        } catch (Exception e) {
            e.printStackTrace();
        }
    }

    private void openOfficerDashboard(Stage stage) {
        try {
            OfficerDashboardUI officerDashboard = new OfficerDashboardUI();
            officerDashboard.start(stage);
        } catch (Exception e) {
            e.printStackTrace();
        }
    }

    private HBox featureItem(String icon, String text) {
        HBox item = new HBox(10);
        item.setAlignment(Pos.CENTER_LEFT);

        Label iconLabel = new Label(icon);
        iconLabel.setFont(Font.font(16));

        Label textLabel = new Label(text);
        textLabel.setFont(Font.font("Arial", 13));
        textLabel.setTextFill(Color.web("#8888aa"));

        item.getChildren().addAll(iconLabel, textLabel);
        return item;
    }

    public static void main(String[] args) {
        launch(args);
    }
}
